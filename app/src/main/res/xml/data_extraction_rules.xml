<?xml version="1.0" encoding="utf-8"?>
<!-- What Android may copy to the user's own cloud backup or to a new phone: the records, plans
     and settings, so a new phone starts where the old one left off. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
